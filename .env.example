# Copy to .env for local development. Never commit .env (see .gitignore).
NODE_ENV=development
HOST=127.0.0.1
PORT=4101
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/parkbro
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
TRUST_PROXY=false
# API_DOCS_ENABLED defaults to true outside production

# Integration tests create and drop throwaway databases through this admin connection.
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Field encryption keyring and blind-index key. These values are PUBLIC development keys: the API refuses to
# start with them outside development/test. Generate real ones with: openssl rand -base64 32
FIELD_ENCRYPTION_KEYS=v1:ZGV2LW9ubHktZmllbGQta2V5LW5ldmVyLXVzZS1pdCE=
BLIND_INDEX_KEY=ZGV2LW9ubHktYmxpbmQtaW5kZXgta2V5LW5ldmVyLXVzZSE=

# OTP delivery: console (prints codes to the API's stderr) or dev-fixed (always OTP_DEV_FIXED_CODE; e2e only).
# There is no production provider yet (DLT-registered SMS/WhatsApp arrives in Phase 18).
OTP_PROVIDER=console
# OTP_DEV_FIXED_CODE=246810

# Per-IP OTP send limit per hour (default 20). Raise only for NAT-heavy networks or automated tests.
# OTP_SEND_LIMIT_PER_IP_PER_HOUR=20

# Scheduled jobs (hold expiry, booking completion, purges) via pg-boss in the `pgboss` schema (default true).
# JOBS_ENABLED=true

# AI layer (Phase 22, docs/ai-strategy.md). 'none' = deterministic rules parser only.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# AI_DAILY_BUDGET_USD=5
# Set from the provider's current price list (USD per million tokens):
# AI_COST_INPUT_USD_PER_MTOK=1
# AI_COST_OUTPUT_USD_PER_MTOK=5

# Operational health for an external monitor: GET /api/health/ops with "Authorization: Bearer <token>".
# Generate with: openssl rand -base64 32. Unset disables the endpoint.
# OPS_MONITOR_TOKEN=

# Controlled pilot (D-168): only customers cleared by trust & safety (admin → user → Pilot clearance) can book.
# Recommended true for launch.
PILOT_CUSTOMER_CLEARANCE=false

# Place search (D-174): 'photon' = OpenStreetMap via Photon (no key); 'fixture' = 15 built-in localities (offline).
GEOCODER_PROVIDER=fixture
# PHOTON_URL=https://photon.komoot.io
